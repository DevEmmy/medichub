{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"], "strict": true, "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "allowImportingTsExtensions": false, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["server/**/*.ts", "src/**/*.ts"],
  "exclude": ["server/ask.example.ts", "server/reminders.example.ts"]
}
