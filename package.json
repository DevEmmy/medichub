{
  "name": "medic-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && STATIC_DIR=dist-app PGLITE_DIR=./data/dev node server-dist/index.mjs",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && VITE_BACKEND=1 vite build --outDir dist-app",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server-dist/index.mjs",
    "build:prod": "npm run build:app && npm run build:server",
    "start": "STATIC_DIR=${STATIC_DIR:-dist-app} node server-dist/index.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:launch": "node qa/launch.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.10.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
